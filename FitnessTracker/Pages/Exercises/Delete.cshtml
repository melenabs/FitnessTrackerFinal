@page
@model FitnessTracker.Pages.Exercises.DeleteModel

@{
    ViewData["Title"] = "Delete Exercise";
}

<h1 class="h3 mb-3">Delete Exercise</h1>

<div class="alert alert-danger">Are you sure you want to delete this?</div>
<div>
    <dl class="row border rounded p-3 mx-0 shadow-sm">
        <dt class="col-sm-3 text-muted">
            @Html.DisplayNameFor(model => model.Exercise.Name)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Exercise.Name)
        </dd>
        <dt class="col-sm-3 text-muted">
            @Html.DisplayNameFor(model => model.Exercise.MuscleGroup)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Exercise.MuscleGroup)
        </dd>
        <dt class="col-sm-3 text-muted">
            @Html.DisplayNameFor(model => model.Exercise.Description)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Exercise.Description)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Exercise.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
    </form>
</div>
