@page
@model FitnessTracker.Pages.Exercises.DetailsModel

@{
    ViewData["Title"] = "Details Exercise";
}

<h1 class="h3 mb-3">Details Exercise</h1>

<div>
    <dl class="row border rounded p-3 mx-0 shadow-sm">
        <dt class="col-sm-3 text-muted">
            @Html.DisplayNameFor(model => model.Exercise.Name)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Exercise.Name)
        </dd>
        <dt class="col-sm-3 text-muted">
            @Html.DisplayNameFor(model => model.Exercise.MuscleGroup)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Exercise.MuscleGroup)
        </dd>
        <dt class="col-sm-3 text-muted">
            @Html.DisplayNameFor(model => model.Exercise.Description)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Exercise.Description)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Exercise.ID" class="btn btn-primary">Edit</a>
    <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
</div>
