@page
@model FitnessTracker.Pages.Workouts.IndexModel

@{
    ViewData["Title"] = "Workouts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Workouts</h1>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</div>
<div class="card shadow-sm">
<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Workout[0].ApplicationUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Workout[0].WorkoutName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Workout[0].WorkoutType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Workout[0].DurationMinutes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Workout[0].CaloriesBurned)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Workout[0].WorkoutDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Workout[0].Notes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Workout) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ApplicationUser.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WorkoutName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WorkoutType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DurationMinutes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CaloriesBurned)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WorkoutDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td class="text-end">
                <div class="btn-group btn-group-sm" role="group">
                    <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@item.ID">Details</a>
                    <a class="btn btn-outline-primary" asp-page="./Edit" asp-route-id="@item.ID">Edit</a>
                    <a class="btn btn-outline-danger" asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
</div>
