@page
@model FitnessTracker.Pages.WorkoutExercises.IndexModel

@{
    ViewData["Title"] = "Workout Exercises";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Workout Exercises</h1>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</div>
<div class="card shadow-sm">
<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.WorkoutExercise[0].Workout)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkoutExercise[0].Exercise)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkoutExercise[0].Sets)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkoutExercise[0].Reps)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkoutExercise[0].WeightUsed)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.WorkoutExercise) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Workout.ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Exercise.ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sets)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Reps)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WeightUsed)
            </td>
            <td class="text-end">
                <div class="btn-group btn-group-sm" role="group">
                    <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@item.ID">Details</a>
                    <a class="btn btn-outline-primary" asp-page="./Edit" asp-route-id="@item.ID">Edit</a>
                    <a class="btn btn-outline-danger" asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
</div>
