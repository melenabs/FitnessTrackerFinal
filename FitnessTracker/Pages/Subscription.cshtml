@page
@model SubscriptionModel
@{
    ViewData["Title"] = "Subscription";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <div class="card h-100 p-4">
            <h2 class="h3">Free Plan</h2>
            <p class="text-muted">Free</p>
            <hr />
            <p class="form-label">What you get</p>
            <ul class="list-unstyled mb-4">
                <li class="mb-2">Meal Tracking</li>
                <li class="mb-2">Workout Tracking</li>
                <li class="mb-2">Goal Tracking</li>
            </ul>
            <button type="button" class="btn btn-outline-primary mt-auto" disabled>Your Current</button>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 p-4">
            <h2 class="h3">Pulse Plus</h2>
            <p class="text-muted">10.99/mo</p>
            <hr />
            <p class="form-label">What you get</p>
            <ul class="list-unstyled mb-4">
                <li class="mb-2">Advanced Insights</li>
                <li class="mb-2">AI Calorie Tracking</li>
                <li class="mb-2">Ai Workout Companion</li>
            </ul>
            <button type="button" class="btn btn-outline-primary mt-auto" disabled>Select</button>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 p-4">
            <h2 class="h3">Pusle Premium</h2>
            <p class="text-muted">49.99/mo</p>
            <hr />
            <p class="form-label">What you get</p>
            <ul class="list-unstyled mb-4">
                <li class="mb-2">Advanced Bloodwork Testing</li>
                <li class="mb-2">Dietician and Personal Trainer Access</li>
                <li class="mb-2">20% off Supplements and Meal Prep</li>
            </ul>
            <button type="button" class="btn btn-outline-primary mt-auto" disabled>Select</button>
        </div>
    </div>
</div>
